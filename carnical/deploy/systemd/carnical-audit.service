# One run of the segmentation checks (the walls between zones and between customers), as an unprivileged user.
# The checks of the machine itself need root and run in carnical-host-audit.service. Started by carnical-audit.timer, a few times a day.
[Unit]
Description=Carnical segmentation audit
After=network-online.target

[Service]
Type=oneshot
User=carnical-audit
Group=carnical-audit
# -allow-skips is NOT set: a check that could not run is reported as a problem, because a check that quietly does not run is
# how a gap stays open.
ExecStart=/usr/local/bin/carnical-audit -zones /etc/carnical/zones.json -log /var/log/carnical/audit.jsonl -status /var/lib/carnical/audit/audit-status.json

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @mount @debug @raw-io @reboot @swap @module @obsolete
UMask=0077
ReadWritePaths=/var/log/carnical /var/lib/carnical/audit
