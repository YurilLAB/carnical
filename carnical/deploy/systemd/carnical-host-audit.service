# One run of the checks of the machine itself: kernel settings, mounts, the services' sandboxes, the network and audit rules, who is
# listening, what is running, and whether anything that should not change has changed.
#
# It needs root to see other users' processes and files, so it is given root and nothing more: five capabilities, no network
# sockets, a read-only machine, and it writes only its own report.
[Unit]
Description=Carnical host audit
After=nftables.service auditd.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/carnical-audit -zones /etc/carnical/zones.json -host -log /var/log/carnical/host-audit.jsonl -status /var/lib/carnical/audit/host-audit-status.json

# Read any file (the manifests), read another user's /proc/PID/exe, list the firewall rules, read the audit rules. Nothing else.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_NET_ADMIN CAP_AUDIT_CONTROL CAP_AUDIT_READ
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# UNIX sockets (systemd) and netlink (nft, audit); no IP sockets, so a taken-over audit cannot send anything anywhere.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any
UMask=0077
ReadWritePaths=/var/log/carnical /var/lib/carnical/audit
