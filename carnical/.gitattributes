# The embedded CRS must stay byte-for-byte what was signed: no line-ending conversion on any platform.
crs/owasp_crs/** -text
crs/owasp-crs-release-key.asc -text
crs/provenance.json -text

# Files that are copied to a Linux machine keep Unix line endings whatever the checkout system does: a script with CRLF
# fails on its first line.
deploy/** text eol=lf
*.sh text eol=lf
